# GitHub Default
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  UseKeychain yes
  AddKeysToAgent yes

# GitHub Secundario
Host github-sec
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_sec
  IdentitiesOnly yes
  UseKeychain yes
  AddKeysToAgent yes

